{
  "name": "mmry-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Mmry REST API - Node.js + TypeScript. The only component that talks to PostgreSQL, MongoDB and the AI service.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/domain.test.ts tests/http.test.ts",
    "db:migrate": "tsx --env-file-if-exists=../.env src/utils/migrate.ts",
    "db:mongo:init": "tsx --env-file-if-exists=../.env src/utils/mongoInit.ts",
    "db:setup": "tsx --env-file-if-exists=../.env src/utils/setupDatabases.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.6.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
