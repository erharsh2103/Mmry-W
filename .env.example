# ---------------------------------------------------------------------------
# Mmry environment template
#
# Copy to `.env` and replace EVERY value marked CHANGE_ME. Nothing in this file
# is a working secret; the services refuse to start with placeholder values.
#
# Generate strong values with:
#   node scripts/generate-secrets.mjs
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- PostgreSQL ------------------------------------------------------------
# Owner account: used only by docker-compose to initialise the cluster and by
# `npm run db:migrate`. The running API never connects with it.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=mmry
POSTGRES_OWNER_USER=mmry_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME_owner_password

# Least-privileged runtime role for the API (SELECT/INSERT/UPDATE/DELETE only).
POSTGRES_APP_USER=mmry_app
POSTGRES_APP_PASSWORD=CHANGE_ME_app_password

# Analytics role: read everything, write only analytics tables.
POSTGRES_ANALYTICS_USER=mmry_analytics
POSTGRES_ANALYTICS_PASSWORD=CHANGE_ME_analytics_password

# --- MongoDB ---------------------------------------------------------------
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=mmry
MONGO_ROOT_USER=mmry_root
MONGO_ROOT_PASSWORD=CHANGE_ME_mongo_root_password
MONGO_APP_USER=mmry_app
MONGO_APP_PASSWORD=CHANGE_ME_mongo_app_password
MONGO_ANALYTICS_USER=mmry_analytics
MONGO_ANALYTICS_PASSWORD=CHANGE_ME_mongo_analytics_password

# --- Backend API -----------------------------------------------------------
BACKEND_PORT=4000
# Browser origin allowed to call the API directly (the frontend normally
# proxies /api, so this matters only when the API is exposed on its own).
CORS_ORIGIN=http://localhost:3000
# Set to true behind HTTPS so auth cookies carry the Secure flag.
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (for client IP / rate limits).
TRUST_PROXY_HOPS=0

# HS256 signing secret for short-lived access tokens. At least 32 characters.
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_random_characters_here
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# AES-256-GCM key for sensitive fields (phone numbers, coordinates, transcripts).
# Exactly 32 bytes, base64-encoded. Losing it makes that data unreadable.
DATA_ENCRYPTION_KEY=CHANGE_ME_base64_encoded_32_byte_key

# --- AI service ------------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret the backend sends to the AI service. At least 32 characters.
AI_SERVICE_TOKEN=CHANGE_ME_at_least_32_random_characters_here
AI_SERVICE_TIMEOUT_MS=4000
AI_SERVICE_PORT=8000

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=3000
# Where the Next.js server forwards /api/* at request time.
BACKEND_INTERNAL_URL=http://127.0.0.1:4000

# --- Analytics -------------------------------------------------------------
ANALYTICS_DASHBOARD_PORT=8501
# Required to open the institutional dashboard. At least 12 characters.
ANALYTICS_DASHBOARD_PASSWORD=CHANGE_ME_dashboard_password
